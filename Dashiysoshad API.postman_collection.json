{
  "info": {
    "_postman_id": "743682c0-d3c7-4e20-b24f-01bd68b943c7",
    "name": "Dashiysoshad API",
    "description": "API test collection. Run requests in order. Set baseUrl, customer test credentials, and admin credentials in collection variables. Admin-only endpoints use adminToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "serverUrl", "value": "http://localhost:5000" },
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "customerEmail", "value": "customer@example.com" },
    { "key": "customerPassword", "value": "CustomerTest123!" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "AdminTest123!" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "guestOrderId", "value": "" },
    { "key": "customerPhone", "value": "01712345678" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API root",
          "request": {
            "method": "GET",
            "url": "{{serverUrl}}/"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer (run once; change email if already registered)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"phone\": \"{{customerPhone}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Customer login (saves accessToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Admin login (saves adminToken; set an existing admin account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.accessToken) pm.collectionVariables.set('adminToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Get current user",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Refresh token (uses login refresh-token cookie)",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh-token", "auth": { "type": "noauth" } }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout", "auth": { "type": "noauth" } }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories?page=1&limit=20&sortOrder=asc", "auth": { "type": "noauth" } }
        },
        {
          "name": "Create category (saves categoryId; admin/staff token required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('categoryId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Category\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/categories",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        },
        {
          "name": "Get category by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories/{{categoryId}}", "auth": { "type": "noauth" } }
        },
        {
          "name": "Update category (admin/staff token required)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Test Category\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": { "method": "GET", "url": "{{baseUrl}}/products?page=1&limit=20&sortBy=createdAt&sortOrder=desc", "auth": { "type": "noauth" } }
        },
        {
          "name": "Create product (saves productId; admin/staff token required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('productId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Garlic Product\",\n  \"description\": \"Product created from Postman test collection\",\n  \"price\": 120,\n  \"sku\": \"TEST-GARLIC-001\",\n  \"stock\": 20,\n  \"weight\": \"500g\",\n  \"categoryId\": \"{{categoryId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/products",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        },
        {
          "name": "Get product by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}", "auth": { "type": "noauth" } }
        },
        {
          "name": "Update product (admin/staff token required)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 125,\n  \"stock\": 25\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/products/{{productId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place guest COD order (saves guestOrderId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('guestOrderId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Test Guest\",\n  \"customerPhone\": \"{{customerPhone}}\",\n  \"shippingAddress\": \"House 10, Road 5, Dhanmondi, Dhaka\",\n  \"country\": \"Bangladesh\",\n  \"paymentMethod\": \"CASH_ON_DELIVERY\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/orders",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Track guest order by ID and phone",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{customerPhone}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders/track/{{guestOrderId}}",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Cancel guest pending order (restores stock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{customerPhone}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders/{{guestOrderId}}/cancel",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Place logged-in customer bKash order (saves orderId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('orderId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Test Customer\",\n  \"customerPhone\": \"{{customerPhone}}\",\n  \"shippingAddress\": \"House 10, Road 5, Dhanmondi, Dhaka\",\n  \"paymentMethod\": \"BKASH\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "List my orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/orders/mine?page=1&limit=20" }
        },
        {
          "name": "List all orders (admin/staff token required)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders?page=1&limit=20&sortOrder=desc",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        },
        {
          "name": "Get order by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/orders/{{orderId}}" }
        },
        {
          "name": "Set free shipping (admin token required)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"shippingFee\": 0\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders/{{orderId}}/shipping",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        },
        {
          "name": "Verify bKash payment (admin/manual verification required)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isPaid\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        },
        {
          "name": "Move order to processing (admin token required)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderStatus\": \"PROCESSING\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        },
        {
          "name": "Move order to shipped (admin token required)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderStatus\": \"SHIPPED\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        },
        {
          "name": "Move order to delivered (admin token required)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderStatus\": \"DELIVERED\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        }
      ]
    },
    {
      "name": "Cleanup (run only after completing order tests)",
      "item": [
        {
          "name": "Soft-delete product (admin token required)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/{{productId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        },
        {
          "name": "Soft-delete category (run after soft-deleting its products; admin token required)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }
          }
        }
      ]
    }
  ]
}
