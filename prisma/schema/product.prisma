model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal   @db.Decimal(12, 2)
  sku         String      @unique
  stock       Int         @default(0)
  images      String[]
  weight      String?
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}