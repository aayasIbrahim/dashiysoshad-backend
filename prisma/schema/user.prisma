model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  phone     String     @unique
  password  String
  role      Role       @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  orders    Order[]
  products  Product[]
  categories Category[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
